<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"
  xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"
  xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main">
  <p:cSld>
    <p:spTree>
      <p:nvGrpSpPr>
        <p:cNvPr id="1" name="">
          <a:extLst>
            <a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}">
              <a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main"
                id="{8FF223DD-C2EB-ABFC-EDF6-00C5FF34B1AF}" />
            </a:ext>
          </a:extLst>
        </p:cNvPr>
        <p:cNvGrpSpPr />
        <p:nvPr />
      </p:nvGrpSpPr>
      <p:grpSpPr>
        <a:xfrm>
          <a:off x="0" y="0" />
          <a:ext cx="0" cy="0" />
          <a:chOff x="0" y="0" />
          <a:chExt cx="0" cy="0" />
        </a:xfrm>
      </p:grpSpPr>

      <%
        margin_x = 380000
        content_right = 11700000
        quote_icon_x = 360000
        quote_icon_y = 1900000
        quote_icon_w = 2190000
        quote_icon_h = 2310000
        text_x = 3040000
        text_y = 1900000
        text_bottom = 4100000
        attribution_image_x = 9830000
        attribution_image_y = 4200000
        attribution_image_w = 1920000
        attribution_image_h = 1290000
        has_attribution_image = !@attribution_image_path.to_s.strip.empty?
        attribution_right = has_attribution_image ? (attribution_image_x - 180000) : content_right
        attribution_y = 4445000
        attribution_cy = 800000
      %>

      <% unless @title.to_s.strip.empty? %>
        <p:sp>
          <p:nvSpPr>
            <p:cNvPr id="2" name="Title 1">
              <a:extLst>
                <a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}">
                  <a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main"
                    id="{3BD56E73-A273-093B-7DD8-7BCA67440717}" />
                </a:ext>
              </a:extLst>
            </p:cNvPr>
            <p:cNvSpPr>
              <a:spLocks noGrp="1" />
            </p:cNvSpPr>
            <p:nvPr>
              <p:ph type="title" />
            </p:nvPr>
          </p:nvSpPr>
          <p:spPr>
            <a:xfrm>
              <a:off x="<%= margin_x %>" y="790000" />
              <a:ext cx="<%= content_right - margin_x %>" cy="560000" />
            </a:xfrm>
          </p:spPr>
          <p:txBody>
            <a:bodyPr vert="horz" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t" anchorCtr="0">
              <a:spAutoFit />
            </a:bodyPr>
            <a:lstStyle />
            <a:p>
              <a:r>
                <a:rPr lang="en-GB" />
                <a:t><%= @title.strip.encode(:xml => :text) %></a:t>
              </a:r>
              <a:endParaRPr lang="en-GB" dirty="0" />
            </a:p>
          </p:txBody>
        </p:sp>
      <% end %>

      <% unless @subtitle.to_s.strip.empty? %>
        <p:sp>
          <p:nvSpPr>
            <p:cNvPr id="4" name="Subtitle">
              <a:extLst>
                <a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}">
                  <a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main"
                    id="{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}" />
                </a:ext>
              </a:extLst>
            </p:cNvPr>
            <p:cNvSpPr txBox="1">
              <a:spLocks />
            </p:cNvSpPr>
            <p:nvPr />
          </p:nvSpPr>
          <p:spPr>
            <a:xfrm>
              <a:off x="<%= margin_x %>" y="1400000" />
              <a:ext cx="<%= content_right - margin_x %>" cy="320000" />
            </a:xfrm>
            <a:prstGeom prst="rect">
              <a:avLst />
            </a:prstGeom>
            <a:noFill />
          </p:spPr>
          <p:txBody>
            <a:bodyPr vert="horz" wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t" anchorCtr="0">
              <a:spAutoFit />
            </a:bodyPr>
            <a:lstStyle>
              <a:lvl1pPr marL="0" indent="0" algn="l">
                <a:buNone />
                <a:defRPr sz="1800">
                  <a:solidFill>
                    <a:srgbClr val="AAAAAA" />
                  </a:solidFill>
                  <a:latin typeface="+mn-lt" />
                </a:defRPr>
              </a:lvl1pPr>
            </a:lstStyle>
            <a:p>
              <a:r>
                <a:rPr lang="en-GB" />
                <a:t><%= @subtitle.strip.encode(:xml => :text) %></a:t>
              </a:r>
            </a:p>
          </p:txBody>
        </p:sp>
      <% end %>

      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="3" name="Slide Number Placeholder 2">
            <a:extLst>
              <a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}">
                <a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main"
                  id="{D193CD14-A295-2EF3-93C5-E51EA4089F30}" />
              </a:ext>
            </a:extLst>
          </p:cNvPr>
          <p:cNvSpPr>
            <a:spLocks noGrp="1" />
          </p:cNvSpPr>
          <p:nvPr>
            <p:ph type="sldNum" sz="quarter" idx="12" />
          </p:nvPr>
        </p:nvSpPr>
        <p:spPr />
        <p:txBody>
          <a:bodyPr />
          <a:lstStyle />
          <a:p>
            <a:fld id="{1A1A750F-FD42-4280-B238-1AD3A0FAB732}" type="slidenum">
              <a:rPr lang="en-GB" smtClean="0" />
              <a:pPr />
              <a:t>5</a:t>
            </a:fld>
            <a:endParaRPr lang="en-GB" />
          </a:p>
        </p:txBody>
      </p:sp>

      <p:pic>
        <p:nvPicPr>
          <p:cNvPr id="5" name="Quote mark">
            <a:extLst>
              <a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}">
                <a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main"
                  id="{CC16FD89-8764-6857-7795-7D57993BE0DC}" />
              </a:ext>
            </a:extLst>
          </p:cNvPr>
          <p:cNvPicPr>
            <a:picLocks noChangeAspect="1" />
          </p:cNvPicPr>
          <p:nvPr />
        </p:nvPicPr>
        <p:blipFill>
          <a:blip r:embed="rId2" />
          <a:stretch>
            <a:fillRect />
          </a:stretch>
        </p:blipFill>
        <p:spPr>
          <a:xfrm>
            <%
              quote_icon_position = size_and_position_image(
                @icon_image_path,
                x: pt_to_pixle(quote_icon_x),
                y: pt_to_pixle(quote_icon_y),
                max_width: pt_to_pixle(quote_icon_w),
                max_height: pt_to_pixle(quote_icon_h),
                v_align: :top,
                h_align: :left
              )
            %>
            <a:off x="<%= pixle_to_pt(quote_icon_position.x) %>" y="<%= pixle_to_pt(quote_icon_position.y) %>" />
            <a:ext cx="<%= pixle_to_pt(quote_icon_position.width) %>" cy="<%= pixle_to_pt(quote_icon_position.height) %>" />
          </a:xfrm>
          <a:prstGeom prst="rect">
            <a:avLst />
          </a:prstGeom>
          <a:noFill />
        </p:spPr>
      </p:pic>

      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="6" name="Quote">
            <a:extLst>
              <a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}">
                <a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main"
                  id="{2E04A62C-B7CA-BB97-041A-5DD8525A8455}" />
              </a:ext>
            </a:extLst>
          </p:cNvPr>
          <p:cNvSpPr txBox="1">
            <a:spLocks />
          </p:cNvSpPr>
          <p:nvPr />
        </p:nvSpPr>
        <p:spPr>
          <a:xfrm>
            <a:off x="<%= text_x %>" y="<%= text_y %>" />
            <a:ext cx="<%= content_right - text_x %>" cy="<%= text_bottom - text_y %>" />
          </a:xfrm>
          <a:prstGeom prst="rect">
            <a:avLst />
          </a:prstGeom>
          <a:noFill />
        </p:spPr>
        <p:txBody>
          <a:bodyPr vert="horz" wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t" anchorCtr="0">
            <a:normAutofit />
          </a:bodyPr>
          <a:lstStyle>
            <a:lvl1pPr marL="0" indent="0" algn="l" defTabSz="914400" rtl="0" eaLnBrk="1" latinLnBrk="0" hangingPunct="1">
              <a:lnSpc>
                <a:spcPct val="115000" />
              </a:lnSpc>
              <a:spcAft>
                <a:spcPts val="0" />
              </a:spcAft>
              <a:buFontTx />
              <a:buNone />
              <a:defRPr sz="1600">
                <a:solidFill>
                  <a:schemeClr val="tx2" />
                </a:solidFill>
                <a:latin typeface="+mn-lt" />
              </a:defRPr>
            </a:lvl1pPr>
          </a:lstStyle>
          <%= content || html_to_ooxml('&nbsp;') %>
        </p:txBody>
      </p:sp>

      <% unless @attribution.to_s.strip.empty? %>
        <p:sp>
          <p:nvSpPr>
            <p:cNvPr id="7" name="Attribution">
              <a:extLst>
                <a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}">
                  <a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main"
                    id="{B2C3D4E5-F6A7-8901-BCDE-F12345678901}" />
                </a:ext>
              </a:extLst>
            </p:cNvPr>
            <p:cNvSpPr txBox="1">
              <a:spLocks />
            </p:cNvSpPr>
            <p:nvPr />
          </p:nvSpPr>
          <p:spPr>
            <a:xfrm>
              <a:off x="<%= margin_x %>" y="<%= attribution_y %>" />
              <a:ext cx="<%= attribution_right - margin_x %>" cy="<%= attribution_cy %>" />
            </a:xfrm>
            <a:prstGeom prst="rect">
              <a:avLst />
            </a:prstGeom>
            <a:noFill />
          </p:spPr>
          <p:txBody>
            <a:bodyPr vert="horz" wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr" anchorCtr="0">
              <a:noAutofit />
            </a:bodyPr>
            <a:lstStyle>
              <a:lvl1pPr marL="0" indent="0" algn="r" defTabSz="914400" rtl="0" eaLnBrk="1" latinLnBrk="0" hangingPunct="1">
                <a:lnSpc>
                  <a:spcPct val="110000" />
                </a:lnSpc>
                <a:spcAft>
                  <a:spcPts val="0" />
                </a:spcAft>
                <a:buFontTx />
                <a:buNone />
                <a:defRPr sz="1400" b="1">
                  <a:solidFill>
                    <a:schemeClr val="tx2" />
                  </a:solidFill>
                  <a:latin typeface="+mn-lt" />
                </a:defRPr>
              </a:lvl1pPr>
            </a:lstStyle>
            <a:p>
              <a:r>
                <a:rPr lang="en-GB" />
                <a:t><%= @attribution.strip.encode(:xml => :text) %></a:t>
              </a:r>
              <a:endParaRPr lang="en-GB" dirty="0" />
            </a:p>
          </p:txBody>
        </p:sp>
      <% end %>

      <% if has_attribution_image %>
        <p:pic>
          <p:nvPicPr>
            <p:cNvPr id="8" name="Attribution image">
              <a:extLst>
                <a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}">
                  <a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main"
                    id="{D3E4F5A6-B7C8-9012-CDEF-123456789012}" />
                </a:ext>
              </a:extLst>
            </p:cNvPr>
            <p:cNvPicPr>
              <a:picLocks noChangeAspect="1" />
            </p:cNvPicPr>
            <p:nvPr />
          </p:nvPicPr>
          <p:blipFill>
            <a:blip r:embed="rId3" />
            <a:stretch>
              <a:fillRect />
            </a:stretch>
          </p:blipFill>
          <p:spPr>
            <a:xfrm>
              <%
                attribution_image_position = size_and_position_image(
                  @attribution_image_path,
                  x: pt_to_pixle(attribution_image_x),
                  y: pt_to_pixle(attribution_image_y),
                  max_width: pt_to_pixle(attribution_image_w),
                  max_height: pt_to_pixle(attribution_image_h),
                  v_align: :bottom,
                  h_align: :right
                )
              %>
              <a:off x="<%= pixle_to_pt(attribution_image_position.x) %>" y="<%= pixle_to_pt(attribution_image_position.y) %>" />
              <a:ext cx="<%= pixle_to_pt(attribution_image_position.width) %>" cy="<%= pixle_to_pt(attribution_image_position.height) %>" />
            </a:xfrm>
            <a:prstGeom prst="rect">
              <a:avLst />
            </a:prstGeom>
            <a:noFill />
          </p:spPr>
        </p:pic>
      <% end %>
    </p:spTree>
    <p:extLst>
      <p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}">
        <p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main"
          val="103443089" />
      </p:ext>
    </p:extLst>
  </p:cSld>
  <p:clrMapOvr>
    <a:masterClrMapping />
  </p:clrMapOvr>
</p:sld>
